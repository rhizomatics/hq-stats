{
  "name": "@rhizomatics/hq-stats",
  "version": "0.4.0",
  "description": "Usage stats for open source projects across the channels they publish to (PyPI, npm, GHCR, HACS, Home Assistant analytics, GitHub traffic, GoatCounter page views), with public pages for Astro/Starlight or raw JSON.",
  "keywords": [
    "analytics",
    "downloads",
    "ghcr",
    "github",
    "goatcounter",
    "hacs",
    "home-assistant",
    "homeassistant",
    "npm",
    "open-source",
    "pypi",
    "stats"
  ],
  "homepage": "https://github.com/rhizomatics/hq-stats#readme",
  "bugs": {
    "url": "https://github.com/rhizomatics/hq-stats/issues"
  },
  "license": "Apache-2.0",
  "author": "jey burrows",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhizomatics/hq-stats.git"
  },
  "bin": {
    "hq-stats": "bin/hq-stats.js"
  },
  "files": [
    "bin/",
    "src/",
    "docs/",
    "examples/",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./astro": "./src/astro/index.js",
    "./brand/logo.svg": "./docs/brand/logo.svg",
    "./pages/*": "./src/astro/pages/*",
    "./sidebar": "./src/astro/sidebar.js",
    "./theme.css": "./src/astro/theme.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "test": "node --test"
  },
  "dependencies": {
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.43.1",
    "astro": "^7.4.11",
    "chart.js": "^4.6.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "peerDependencies": {
    "@astrojs/starlight": ">=0.42.0",
    "astro": ">=7.0.0",
    "chart.js": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "@astrojs/starlight": {
      "optional": true
    },
    "astro": {
      "optional": true
    },
    "chart.js": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
